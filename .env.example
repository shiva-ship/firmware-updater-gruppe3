# Kopieren nach .env und bei Bedarf anpassen. Diese Datei enthält KEINE Zugangsdaten
# und darf auch keine enthalten – Benutzer werden per CLI angelegt.

# production | development  (development aktiviert nur /api/docs, nie im Produktivbetrieb)
ASM_ENVIRONMENT=production

# Standard: nur lokal erreichbar
ASM_HOST=127.0.0.1
ASM_PORT=8000
# Erlaubte Host-Header (kommagetrennt), Schutz gegen DNS-Rebinding
ASM_ALLOWED_HOSTS=127.0.0.1,localhost

# Datenverzeichnis für Benutzerdatenbank und temporäre Uploads.
# Standard (leer lassen): %LOCALAPPDATA%\ADS-TEC-Security-Manager
# ASM_DATA_DIR=C:\Pfad\außerhalb\des\Repositories

# Sitzungen
ASM_SESSION_IDLE_MINUTES=30
ASM_SESSION_ABSOLUTE_HOURS=8

# Brute-Force-Schutz Login (Fehlversuche / Zeitfenster / Sperrdauer in Sekunden)
ASM_LOGIN_MAX_ATTEMPTS=5
ASM_LOGIN_WINDOW_SECONDS=900
ASM_LOGIN_LOCKOUT_SECONDS=900

# Brute-Force-Schutz Masterpasswort (pro Benutzer und Datenbank)
ASM_UNLOCK_MAX_ATTEMPTS=5
ASM_UNLOCK_WINDOW_SECONDS=300
ASM_UNLOCK_LOCKOUT_SECONDS=300

# Uploads
ASM_MAX_UPLOAD_BYTES=20971520
ASM_MAX_DATABASES_PER_SESSION=5

# --- Spätere LAN-Nutzung: NUR mit HTTPS ---
# Ohne Zertifikat verweigert der Server den Start auf Nicht-Loopback-Adressen.
# ASM_HOST=0.0.0.0
# ASM_ALLOWED_HOSTS=security-manager.firma.local
# ASM_TLS_CERTFILE=C:\certs\security-manager.crt
# ASM_TLS_KEYFILE=C:\certs\security-manager.key
